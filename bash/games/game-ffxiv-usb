#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'

# Ensure that all the USB related daemons are restarted and fresh.
systemctl --user restart openrazer-daemon.service || true
input-remapper-restart

# The G604 and the Naga are alternatives. Start FFXIV on each one that is
# plugged in, and on the Tartarus when that is plugged in too.
start_if_present() {
    local device=$1
    local preset=$2

    if /usr/bin/input-remapper-control --list-devices 2>/dev/null | grep -qxF "${device}"; then
        echo "Starting ${preset} on ${device}."
        /usr/bin/input-remapper-control --command start --device "${device}" --preset "${preset}"
        return 0
    fi

    echo "Skipping ${device}: not connected."
    return 1
}

mouse_started=0
start_if_present "Logitech G604 " "FFXIV" && mouse_started=1 || true
start_if_present "Razer Razer Naga V2 Pro" "FFXIV" && mouse_started=1 || true
start_if_present "Razer Razer Tartarus V2" "FFXIV" || true

if (( mouse_started == 0 )); then
    echo "Neither the G604 nor the Naga V2 Pro is connected." >&2
fi
