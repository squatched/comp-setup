#!/usr/bin/env bash

# Add ~/.local/bin/ to PATH unless it already exists (varies per distro)
echo "${PATH}" | grep "${HOME}/.local/bin" >/dev/null || export PATH="${HOME}/.local/bin:${PATH}"

# I always want my emacsclient as my editor...
export VISUAL='emacsclient --tty --alternate-editor=""'

# Expose the ssh-agent's socket.
# NOTE: this assumes the systemd user ssh-agent.socket is the agent holding your
# keys. On desktops where the session manager starts its own agent instead (KDE
# Plasma, GNOME), this can point at a different, empty agent -- override it in
# ~/.bash_environment on those machines.
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.socket"

if hash go 2>/dev/null; then
    export GOPATH="${HOME}/.go"
    export PATH="${PATH}:${GOPATH}/bin"
fi
